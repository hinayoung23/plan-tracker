{
  "name": "plan-tracker",
  "version": "2.13.2",
  "description": "MCP server for long-term plan tracking — milestones, daily check-ins, webhook push notifications, event-scheduled reminders, and AI-assisted progress analysis. OpenClaw plugin.",
  "main": "src/index.js",
  "keywords": ["openclaw", "plugin", "mcp", "plan", "tracker", "reminder", "productivity"],
  "license": "MIT",
  "author": "hinayoung23",
  "files": [
    "src/*.js",
    "plan_tracker/**/*.py",
    "scripts/*.py",
    "scripts/*.sh",
    "skill/SKILL.md",
    "data/.gitkeep",
    "README.md",
    "LICENSE",
    "openclaw.plugin.json",
    "pyproject.toml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hinayoung23/plan-tracker.git"
  },
  "openclaw": {
    "extensions": ["./src/index.js"],
    "install": {
      "defaultChoice": "git",
      "minHostVersion": ">=2026.5.28"
    },
    "compat": {
      "pluginApi": ">=2026.5.28"
    },
    "build": {
      "openclawVersion": "2026.5.28"
    },
    "release": {
      "publishToClawHub": true
    }
  },
  "scripts": {
    "postinstall": "bash scripts/setup.sh"
  }
}
